{
  "meta": {
    "name": "Canonical AE Observability / Metrics / Experiments / Learning Protocol",
    "version": "L1-K-stage1-review2",
    "representation_status": "conforming_machine_representation",
    "semantic_authority": "human_semantic_specification",
    "technology_semantics": "JSON/Python/CI are reference choices, not Canonical AE technology"
  },
  "domain_semantics": {
    "metric_definition": "B",
    "provider_measurement_resource": "C",
    "dashboard_analytics_view": "D",
    "experiment": "A1",
    "learning_record": "A2",
    "effective_observability_configuration": "D"
  },
  "minimum_measure_categories": [
    {"id":"total_time_to_outcome","semantic":"explicit outcome scope with canonical start/end semantics"},
    {"id":"phase_time","semantic":"identified canonical AE interval/phase"},
    {"id":"loop_count","semantic":"derived from canonical AE Loop history"},
    {"id":"failed_validation_loops","semantic":"derived from canonical Validation/lifecycle history"},
    {"id":"human_effort","semantic":"basis identifies measured/reported/estimated/derived"},
    {"id":"agent_model_cost","semantic":"actual/estimated source and calculation basis, units/currency, scope"},
    {"id":"quality_assessment","semantic":"method/scope/Evidence basis identifiable; no universal score"},
    {"id":"organization_selected","semantic":"organization/product-selected additional measures supported"}
  ],
  "metric_definition_fields_as_applicable": ["measure_id_name","purpose_question","population_scope","start_stop_time_window","units","authoritative_source_reference","computation_aggregation","inclusion_exclusion","exact_definition_revision_effectivity","data_quality_completeness_limitations","provenance"],
  "human_effort_basis_types": ["MEASURED","REPORTED","ESTIMATED","DERIVED"],
  "cost_basis_types": ["ACTUAL_PROVIDER_COST","ESTIMATED_PROVIDER_COST","DERIVED_COST"],
  "experiment_lifecycle": {
    "states": ["PROPOSED","ACTIVE","CONCLUDED","CANCELLED"],
    "terminal_states": ["CONCLUDED","CANCELLED"],
    "inconclusive_is_result_not_state": true,
    "allowed_transitions": [["PROPOSED","ACTIVE"],["PROPOSED","CANCELLED"],["ACTIVE","CONCLUDED"],["ACTIVE","CANCELLED"]]
  },
  "experiment_fields_as_applicable": ["experiment_id","question_hypothesis","scope_context","baseline_comparator","intervention","measurement_plan","evidence_observation_provider_references","limitations_confounders_uncertainty","result","conclusion","learning_decision_configuration_relationships","provenance_revisions_currentness"],
  "learning_materiality_test": "Would losing this evidence-backed conclusion materially reduce the quality of future engineering decisions?",
  "loop_learning_dispositions": ["MATERIAL_LEARNING_CREATED","EXISTING_LEARNING_QUALIFIED_REINFORCED_OR_SUPERSEDED","EXPERIMENT_UPDATED_OR_CONCLUDED","NO_MATERIAL_LEARNING_IDENTIFIED"],
  "learning_sources": ["EXPERIMENT","AE_LOOP","VALIDATION_FAILURE","INCIDENT","SIDE_QUEST_OR_DISCOVERY","ENGINEERING_HEALTH_REMEDIATION","OTHER_GOVERNED_DISCOVERY"],
  "rules": {
    "federated_r7_boundary": true,
    "provider_telemetry_may_remain_external": true,
    "raw_telemetry_point_not_canonical_state": true,
    "provider_observability_technology_not_canonical": true,
    "metric_definition_subordinate_b": true,
    "dashboard_not_authoritative": true,
    "effective_observability_view_derived": true,
    "no_metric_measurement_observation_a1_a2": true,
    "minimum_measures_are_neutral_observations": true,
    "no_faster_cheaper_auto_better": true,
    "no_universal_roi_formula": true,
    "no_universal_performance_score": true,
    "no_universal_quality_score": true,
    "lifecycle_metrics_use_canonical_history": true,
    "telemetry_not_evidence_by_default": true,
    "telemetry_not_learning_by_default": true,
    "material_measurement_reference_reconstructable": true,
    "provider_metric_not_validation": true,
    "experiment_a1_existing_identity": true,
    "experiment_active_material_change_versioned": true,
    "experiment_concluded_history_non_destructive": true,
    "experiment_conclusion_strength_bounded_by_design_evidence": true,
    "experiment_method_not_canonicalized": true,
    "experiment_does_not_bypass_lifecycle_authority": true,
    "experiment_provenance_survives_actor_session_loss": true,
    "inconclusive_may_be_concluded": true,
    "no_experiment_run_observation_entity": true,
    "experiment_transition_history_reconstructable": true,
    "learning_record_material_only": true,
    "loop_closure_learning_disposition_required": true,
    "no_ceremonial_learning_record": true,
    "learning_history_non_destructive": true,
    "learning_informative_not_self_authorizing": true,
    "consequential_change_uses_governed_mechanism": true,
    "learning_provenance_survives_actor_session_loss": true,
    "preauthorized_adaptation_allowed_within_boundary": true,
    "adaptation_cannot_expand_authority": true,
    "adaptation_cannot_weaken_policy": true,
    "adaptation_cannot_redefine_contract_success": true,
    "later_invalid_telemetry_changes_current_reliance_not_history": true,
    "observability_subject_to_access_classification_policy": true,
    "data_minimization_required": true,
    "no_universal_prompt_logging": true,
    "no_chain_of_thought_retention": true,
    "no_universal_surveillance": true,
    "no_central_r7_service_required": true,
    "oeb_product_may_specialize_not_weaken": true,
    "no_new_l1k_a1_a2_required": true
  },
  "cross_domain_expectations": {
    "lifecycle_rules": ["learning_disposition_required_for_loop_closure","transition_history_non_destructively_reconstructable"],
    "observability_capability_operations": ["telemetry.emit","telemetry.query","telemetry.read"],
    "authority_rules": ["canonical_constraints_not_weakened_downstream","self_escalation_prohibited"],
    "context_rules": ["context_package_not_authoritative","no_prompt_logging_requirement"],
    "planning_execution_verification_chain": ["CONTRACT_PROOF","PLAN_VERIFICATION_TEST_STRATEGY","EXECUTION_VERIFICATION_AND_EVIDENCE","INDEPENDENT_VALIDATION"],
    "validation_rules": ["historical_evidence_validation_non_destructive","provider_green_not_validation"],
    "standards_health_rules": ["tool_output_not_authoritative_finding_by_itself","health_history_non_destructive"]
  }
}

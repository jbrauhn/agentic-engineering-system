{
  "meta": {
    "name": "L1-D lifecycle scenario fixtures",
    "version": "L1-D-stage1"
  },
  "scenarios": [
    {
      "id": "valid_happy_path",
      "expect": "PASS",
      "initial": {
        "loop": {"id": "LOOP-1", "state": "OPEN", "approved_contract_revision": "C@2"},
        "increments": {
          "INC-A": {
            "position": "PLANNING",
            "contract_revision": "C@2",
            "plan_revision": "P@4",
            "baseline_revision": "B@8",
            "tasks": {"TASK-A1": {"state": "NOT_STARTED"}}
          }
        }
      },
      "steps": [
        {"action": "set_gate", "scope": "INC-A", "gate": "G1_CONTRACT_APPROVAL", "status": "SATISFIED", "record": "AUTH-C2", "target_contract_revision": "C@2"},
        {"action": "set_gate", "scope": "INC-A", "gate": "G2_PLAN_REVIEW", "status": "SATISFIED", "record": "PR-4A", "target_plan_revision": "P@4", "review_scope": [{"type": "EXECUTION_INCREMENT", "id": "INC-A"}]},
        {"action": "transition", "scope": "INC-A", "transition": "increment.plan_to_ready", "presented_contract_revision": "C@2", "presented_plan_revision": "P@4", "presented_baseline_revision": "B@8"},
        {"action": "set_gate", "scope": "INC-A", "gate": "G3_AUTHORITY", "status": "SATISFIED", "record": "OA-1"},
        {"action": "transition", "scope": "INC-A", "transition": "increment.ready_to_executing", "actor": "agent-exec", "presented_contract_revision": "C@2", "presented_plan_revision": "P@4", "presented_baseline_revision": "B@8"},
        {"action": "provider_status", "scope": "INC-A", "task": "TASK-A1", "provider_status": "Done"},
        {"action": "set_task_state", "scope": "INC-A", "task": "TASK-A1", "state": "COMPLETE"},
        {"action": "transition", "scope": "INC-A", "transition": "increment.executing_to_validating", "presented_contract_revision": "C@2", "presented_plan_revision": "P@4", "presented_baseline_revision": "B@8"},
        {"action": "set_gate", "scope": "INC-A", "gate": "G4_VALIDATION_ACCEPTANCE", "status": "SATISFIED", "record": "VAL-A", "target_contract_revision": "C@2", "validator": "agent-val", "producer": "agent-exec"},
        {"action": "transition", "scope": "INC-A", "transition": "increment.validating_accept", "presented_contract_revision": "C@2", "presented_plan_revision": "P@4", "presented_baseline_revision": "B@8"},
        {"action": "set_gate", "scope": "LOOP-1", "gate": "G4_VALIDATION_ACCEPTANCE", "status": "SATISFIED", "record": "VAL-FINAL", "target_contract_revision": "C@2", "validator": "agent-val", "producer": "agent-exec", "final_contract_scope": true},
        {"action": "final_reconciliation", "final_contract_revision": "C@2", "scope_contract_revisions": {"INC-A": "C@2"}},
        {"action": "learning_disposition", "material_learning": false},
        {"action": "transition", "scope": "LOOP-1", "transition": "loop.close_accepted", "presented_contract_revision": "C@2"}
      ]
    },

  "cross_domain_expectations": {
    "lifecycle_gate": "G4_VALIDATION_ACCEPTANCE",
    "lifecycle_routes": ["ACCEPT", "RETRY_EXECUTION", "REPLAN", "PROPOSE_CONTRACT_CHANGE", "ESCALATE"],
    "validation_capability_operations": ["validation.request", "validation.status", "validation.result.read", "validation.evidence.read"],
    "authority_runtime_outcomes": ["ALLOWED", "DENIED", "BLOCKED"],
    "context_rules": ["context_package_not_authoritative", "context_package_not_evidence_by_default", "unresolved_authority_conflict_blocks_protected_use"],

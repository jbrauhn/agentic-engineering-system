  "rules": {
    "memory_is_system_property_not_store": true,
    "agent_does_not_own_memory": true,
    "r2_owns_authoritative_state_r3_coordinates_context": true,
    "no_generic_knowledge_item_or_memory_record": true,
    "context_package_not_authoritative": true,
    "context_package_reconstructable": true,
    "context_receipt_not_a2": true,
    "handoff_existing_a2_not_current_source_truth": true,
    "handoff_conditionally_required": true,
    "replacement_actor_reconstructable": true,
    "hidden_session_state_not_material_source": true,
    "anchor_first_relevance_expanding": true,
    "mandatory_anchors_not_displaced_by_relevance": true,
    "correct_effective_beats_latest": true,
    "context_invalidation_not_source_mutation": true,
    "unresolved_authority_conflict_blocks_protected_use": true,
    "derived_retrieval_state_not_authoritative": true,
    "knowledge_write_does_not_create_canonical_truth": true,
    "semantic_owner_promotion_required_for_canonical_state": true,
    "compaction_not_canonical_state": true,
    "material_state_promoted_before_intentional_compaction": true,
    "derived_context_no_broader_access_than_source": true,
    "context_package_not_evidence_by_default": true,
    "consequential_context_provenance_conditional": true,
    "routine_context_provenance_not_permanently_required": true,
    "interface_parity_not_environment_uniformity": true,
    "no_prompt_logging_requirement": true,
    "no_vector_rag_memory_technology_required": true
  }
